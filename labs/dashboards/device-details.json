      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(kentik_snmp_ifInErrors{device_name=~\"$device\"} / 60)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
