{
  "uid": "workshop-device-summary",
  "title": "Workshop Device Summary",
  "description": "Fleet overview of the workshop campus (ktranslate-shaped SNMP). Start at alerts, then click a device to open Device Details.",
  "tags": [
    "workshop",
    "network-o11y",
    "ktranslate"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-prom",
          "value": "grafanacloud-prom"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "grafanacloud-logs",
          "value": "grafanacloud-logs"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1
      },
      {
        "name": "infinity",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {
          "text": "workshop-network-apis",
          "value": "workshop-network-apis"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1
      },
      {
        "name": "snmp_group",
        "label": "SNMP group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kentik_snmp_PollingHealth{service_name=\"ktranslate-snmp-workshop\"}, tags_snmp_group)",
        "query": "label_values(kentik_snmp_PollingHealth{service_name=\"ktranslate-snmp-workshop\"}, tags_snmp_group)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kentik_snmp_PollingHealth{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"}, provider)",
        "query": "label_values(kentik_snmp_PollingHealth{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"}, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "device_name",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kentik_snmp_PollingHealth{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"}, device_name)",
        "query": "label_values(kentik_snmp_PollingHealth{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"}, device_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet Alerts",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "alertlist",
      "title": "Active Network Alerts",
      "description": "Firing and pending instances from Workshop / campus.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 20,
        "sortOrder": 3,
        "dashboardAlerts": false,
        "alertName": "",
        "folderUID": "workshop-network",
        "alertInstanceLabelFilter": "{source=\"workshop\"}",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": false
        }
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Fleet Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Devices",
      "description": "Unique devices reporting SNMP polling health",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(count by(device_name) (kentik_snmp_PollingHealth{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"})) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Interfaces Down",
      "description": "Oper-down interfaces across the filtered fleet",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(kentik_snmp_if_OperStatus{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"} == 2) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Avg Fleet CPU",
      "description": "Average of each device's CPU",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg(max by(device_name) (kentik_snmp_CPU{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"}))",
          "refId": "A",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total Fleet Traffic",
      "description": "Sum of in+out bits/sec (ktranslate 60s delta gauges)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum((kentik_snmp_ifHCInOctets{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"} + kentik_snmp_ifHCOutOctets{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"}) * 8 / 60)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Device Status",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Device Status",
      "description": "Click Device to open the detail view.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by(device_name, provider, tags_kentik_model) (kentik_snmp_CPU{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by(device_name) (kentik_snmp_MemoryUtilization{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by(device_name) (kentik_snmp_PollingHealth{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"})",
          "refId": "C",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by(device_name) (kentik_snmp_ifInErrors{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"} / 60)",
          "refId": "D",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by(device_name) ((kentik_snmp_ifHCInOctets{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"} + kentik_snmp_ifHCOutOctets{tags_snmp_group=~\"$snmp_group\", provider=~\"$provider\", device_name=~\"$device_name\"}) * 8 / 60)",
          "refId": "E",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Index": true,
              "__name__": true,
              "job": true,
              "deployment_host": true,
              "service_name": true,
              "src_addr": true,
              "tags_container_service": true,
              "instrumentation_name": true,
              "tags_snmp_group": true
            },
            "renameByName": {
              "device_name": "Device",
              "provider": "Provider",
              "tags_kentik_model": "Model",
              "Value #A": "CPU %",
              "Value #B": "Memory %",
              "Value #C": "Poll",
              "Value #D": "Errors/s",
              "Value #E": "bps"
            },
            "indexByName": {
              "Device": 0,
              "Provider": 1,
              "Model": 2,
              "CPU %": 3,
              "Memory %": 4,
              "Poll": 5,
              "Errors/s": 6,
              "bps": 7
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Device"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Device details",
                    "url": "/d/workshop-device-details?var-device=${__data.fields.Device}&var-datasource=${datasource}&var-loki=${loki}&from=${__from}&to=${__to}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
