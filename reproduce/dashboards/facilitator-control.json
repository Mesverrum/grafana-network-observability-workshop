      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(probe_duration_seconds{job=\"workshop-tcp\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
