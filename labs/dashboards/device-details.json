    {
      "id": 9,
      "type": "table",
      "title": "Interface Status",
      "description": "Oper 1 = up. Sort Errors/s or bps to find the outlier.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by(if_interface_name, if_Alias) (kentik_snmp_if_OperStatus{device_name=~\"$device\", if_interface_name=~\"$interface\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by(if_interface_name) (kentik_snmp_ifInErrors{device_name=~\"$device\", if_interface_name=~\"$interface\"} / 60)",
          "refId": "B",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by(if_interface_name) ((kentik_snmp_ifHCInOctets{device_name=~\"$device\", if_interface_name=~\"$interface\"}) * 8 / 60)",
          "refId": "C",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by(if_interface_name) ((kentik_snmp_ifHCOutOctets{device_name=~\"$device\", if_interface_name=~\"$interface\"}) * 8 / 60)",
          "refId": "D",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Index": true,
              "__name__": true,
              "job": true,
              "deployment_host": true,
              "service_name": true,
              "src_addr": true,
              "tags_container_service": true,
              "instrumentation_name": true,
              "tags_snmp_group": true,
              "device_name": true
            },
            "renameByName": {
              "if_interface_name": "Interface",
              "if_Alias": "Alias",
              "Value #A": "Oper",
              "Value #B": "Errors/s",
              "Value #C": "In bps",
              "Value #D": "Out bps"
            },
            "indexByName": {
              "Interface": 0,
              "Alias": 1,
              "Oper": 2,
              "Errors/s": 3,
              "In bps": 4,
              "Out bps": 5
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
