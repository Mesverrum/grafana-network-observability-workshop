    {
      "id": 4,
      "type": "stat",
      "title": "TCP duration (workshop-tcp)",
      "description": "Last duration from Synthetic Monitoring. Expect this to rise after the agent applies the hairpin.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 6
