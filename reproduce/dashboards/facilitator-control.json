  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Facilitator only",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "This board is **not** for attendees. Click a control table to POST `/admin/hairpin` through Infinity (`workshop-hairpin-control`). The private-probe host polls that flag and runs **your** on/off commands \u2014 no DNS flip.\n\nNeed **Editor** (Viewers cannot run visualization actions). If the click does nothing, edit the panel \u2192 Data links and actions \u2192 Connection = the Infinity datasource `workshop-hairpin-control`.\n\nSetup notes live in `reproduce/facilitator/hairpin.md`."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Desired path",
      "description": "0 = direct US. 1 = Singapore hairpin requested.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${infinity}"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "/admin/hairpin",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": []
          },
          "format": "table",
          "parser": "backend",
          "root_selector": "",
          "columns": [
            {
              "selector": "active_num",
              "text": "Desired path",
              "type": "number"
